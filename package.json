{
    "name": "cla-wrapper",
    "version": "0.3.10",
    "description": "Wrapper for CDISC Library API",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "ts-node-esm src/index.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "prepare": "husky install",
    "release": "semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tomhub/cla-wrapper.git"
  },
  "keywords": [
    "cdisc",
    "library",
    "api",
    "typescript"
  ],
  "author": "Tom",
  "license": "MIT",
  "dependencies": {
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.30.0",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "semantic-release": "^23.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.0",
    "vitest": "^1.4.0",
    "msw": "^1.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
